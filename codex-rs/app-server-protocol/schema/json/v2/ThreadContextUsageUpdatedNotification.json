{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "ThreadContextUsage": {
      "properties": {
        "budgetUsedPercent": {
          "format": "int64",
          "type": [
            "integer",
            "null"
          ]
        },
        "categories": {
          "$ref": "#/definitions/ThreadContextUsageCategoryBreakdown"
        },
        "loadedSkills": {
          "$ref": "#/definitions/ThreadContextUsageLoadedSkills"
        },
        "totalBytes": {
          "format": "int64",
          "type": "integer"
        }
      },
      "required": [
        "categories",
        "loadedSkills",
        "totalBytes"
      ],
      "type": "object"
    },
    "ThreadContextUsageCategoryBreakdown": {
      "properties": {
        "compact": {
          "format": "int64",
          "type": "integer"
        },
        "concreteSkills": {
          "format": "int64",
          "type": "integer"
        },
        "llmMessages": {
          "format": "int64",
          "type": "integer"
        },
        "reasoning": {
          "format": "int64",
          "type": "integer"
        },
        "skillsMetadata": {
          "format": "int64",
          "type": "integer"
        },
        "toolCalls": {
          "format": "int64",
          "type": "integer"
        },
        "toolsMetadata": {
          "format": "int64",
          "type": "integer"
        },
        "userMessages": {
          "format": "int64",
          "type": "integer"
        }
      },
      "required": [
        "compact",
        "concreteSkills",
        "llmMessages",
        "reasoning",
        "skillsMetadata",
        "toolCalls",
        "toolsMetadata",
        "userMessages"
      ],
      "type": "object"
    },
    "ThreadContextUsageLoadedSkills": {
      "properties": {
        "loadedCount": {
          "format": "uint32",
          "minimum": 0.0,
          "type": "integer"
        },
        "skills": {
          "items": {
            "$ref": "#/definitions/ThreadContextUsageSkill"
          },
          "type": "array"
        },
        "totalCount": {
          "format": "uint32",
          "minimum": 0.0,
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "required": [
        "loadedCount",
        "skills"
      ],
      "type": "object"
    },
    "ThreadContextUsageSkill": {
      "properties": {
        "kind": {
          "$ref": "#/definitions/ThreadSkillKind"
        },
        "loadCount": {
          "format": "uint32",
          "minimum": 0.0,
          "type": "integer"
        },
        "name": {
          "type": "string"
        },
        "path": {
          "type": "string"
        }
      },
      "required": [
        "kind",
        "loadCount",
        "name",
        "path"
      ],
      "type": "object"
    },
    "ThreadSkillKind": {
      "enum": [
        "explicit",
        "implicit",
        "all"
      ],
      "type": "string"
    }
  },
  "properties": {
    "contextUsage": {
      "$ref": "#/definitions/ThreadContextUsage"
    },
    "threadId": {
      "type": "string"
    },
    "turnId": {
      "type": "string"
    }
  },
  "required": [
    "contextUsage",
    "threadId",
    "turnId"
  ],
  "title": "ThreadContextUsageUpdatedNotification",
  "type": "object"
}