{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "AgentType": {
      "properties": {
        "builtIn": {
          "type": "boolean"
        },
        "description": {
          "type": [
            "string",
            "null"
          ]
        },
        "name": {
          "type": "string"
        }
      },
      "required": [
        "builtIn",
        "name"
      ],
      "type": "object"
    },
    "ThreadProviderCapabilities": {
      "properties": {
        "closeThread": {
          "type": "boolean"
        },
        "commandSession": {
          "type": "boolean"
        },
        "compact": {
          "type": "boolean"
        },
        "dynamicTools": {
          "type": "boolean"
        },
        "eventStream": {
          "type": "boolean"
        },
        "listChildren": {
          "type": "boolean"
        },
        "permissions": {
          "type": "boolean"
        },
        "pollEvent": {
          "type": "boolean"
        },
        "restoreSnapshot": {
          "description": "Supports opening persisted thread history as a read-only snapshot.",
          "type": "boolean"
        },
        "restoreThread": {
          "description": "Supports restoring a persisted thread into a live, interactive runtime.",
          "type": "boolean"
        },
        "sendInput": {
          "type": "boolean"
        },
        "spawnChild": {
          "type": "boolean"
        },
        "startThread": {
          "type": "boolean"
        },
        "workflow": {
          "type": "boolean"
        }
      },
      "required": [
        "closeThread",
        "commandSession",
        "compact",
        "dynamicTools",
        "eventStream",
        "listChildren",
        "permissions",
        "pollEvent",
        "restoreSnapshot",
        "restoreThread",
        "sendInput",
        "spawnChild",
        "startThread",
        "workflow"
      ],
      "type": "object"
    },
    "ThreadProviderDescriptor": {
      "properties": {
        "agentTypes": {
          "items": {
            "$ref": "#/definitions/AgentType"
          },
          "type": "array"
        },
        "capabilities": {
          "$ref": "#/definitions/ThreadProviderCapabilities"
        },
        "description": {
          "type": "string"
        },
        "displayName": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "kind": {
          "$ref": "#/definitions/ThreadProviderKind"
        },
        "modelSelection": {
          "$ref": "#/definitions/ThreadProviderModelSelection"
        }
      },
      "required": [
        "agentTypes",
        "capabilities",
        "description",
        "displayName",
        "id",
        "kind",
        "modelSelection"
      ],
      "type": "object"
    },
    "ThreadProviderKind": {
      "enum": [
        "native",
        "externalCli"
      ],
      "type": "string"
    },
    "ThreadProviderModelSelection": {
      "properties": {
        "mode": {
          "$ref": "#/definitions/ThreadProviderModelSelectionMode"
        },
        "modelProviders": {
          "default": [],
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "mode"
      ],
      "type": "object"
    },
    "ThreadProviderModelSelectionMode": {
      "enum": [
        "catalog",
        "providerDefault",
        "none"
      ],
      "type": "string"
    }
  },
  "properties": {
    "data": {
      "items": {
        "$ref": "#/definitions/ThreadProviderDescriptor"
      },
      "type": "array"
    }
  },
  "required": [
    "data"
  ],
  "title": "ThreadProviderListResponse",
  "type": "object"
}