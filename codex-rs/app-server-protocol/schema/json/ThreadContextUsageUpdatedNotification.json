{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "ThreadContextUsage": {
      "properties": {
        "budgetUsedPercent": {
          "format": "int64",
          "type": [
            "integer",
            "null"
          ]
        },
        "categories": {
          "$ref": "#/definitions/ThreadContextUsageCategoryBreakdown"
        },
        "loadedSkills": {
          "$ref": "#/definitions/ThreadContextUsageLoadedSkills"
        },
        "toolBreakdown": {
          "allOf": [
            {
              "$ref": "#/definitions/ThreadContextUsageToolBreakdown"
            }
          ],
          "default": {
            "applyPatch": {
              "input": 0,
              "output": 0
            },
            "commands": {
              "input": 0,
              "output": 0
            },
            "fileOperations": {
              "input": 0,
              "output": 0
            },
            "interAgent": {
              "input": 0,
              "output": 0
            },
            "otherTools": {
              "input": 0,
              "output": 0
            },
            "searchMedia": {
              "input": 0,
              "output": 0
            }
          }
        },
        "totalBytes": {
          "format": "int64",
          "type": "integer"
        }
      },
      "required": [
        "categories",
        "loadedSkills",
        "totalBytes"
      ],
      "type": "object"
    },
    "ThreadContextUsageCategoryBreakdown": {
      "properties": {
        "compact": {
          "format": "int64",
          "type": "integer"
        },
        "concreteSkills": {
          "format": "int64",
          "type": "integer"
        },
        "llmMessages": {
          "format": "int64",
          "type": "integer"
        },
        "reasoning": {
          "format": "int64",
          "type": "integer"
        },
        "skillsMetadata": {
          "format": "int64",
          "type": "integer"
        },
        "toolCalls": {
          "format": "int64",
          "type": "integer"
        },
        "toolsMetadata": {
          "format": "int64",
          "type": "integer"
        },
        "userMessages": {
          "format": "int64",
          "type": "integer"
        }
      },
      "required": [
        "compact",
        "concreteSkills",
        "llmMessages",
        "reasoning",
        "skillsMetadata",
        "toolCalls",
        "toolsMetadata",
        "userMessages"
      ],
      "type": "object"
    },
    "ThreadContextUsageLoadedSkills": {
      "properties": {
        "loadedCount": {
          "format": "uint32",
          "minimum": 0.0,
          "type": "integer"
        },
        "skills": {
          "items": {
            "$ref": "#/definitions/ThreadContextUsageSkill"
          },
          "type": "array"
        },
        "totalCount": {
          "format": "uint32",
          "minimum": 0.0,
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "required": [
        "loadedCount",
        "skills"
      ],
      "type": "object"
    },
    "ThreadContextUsageSkill": {
      "properties": {
        "kind": {
          "$ref": "#/definitions/ThreadSkillKind"
        },
        "loadCount": {
          "format": "uint32",
          "minimum": 0.0,
          "type": "integer"
        },
        "name": {
          "type": "string"
        },
        "path": {
          "type": "string"
        }
      },
      "required": [
        "kind",
        "loadCount",
        "name",
        "path"
      ],
      "type": "object"
    },
    "ThreadContextUsageToolBreakdown": {
      "properties": {
        "applyPatch": {
          "$ref": "#/definitions/ThreadContextUsageToolBucket"
        },
        "commands": {
          "$ref": "#/definitions/ThreadContextUsageToolBucket"
        },
        "fileOperations": {
          "$ref": "#/definitions/ThreadContextUsageToolBucket"
        },
        "interAgent": {
          "$ref": "#/definitions/ThreadContextUsageToolBucket"
        },
        "otherTools": {
          "$ref": "#/definitions/ThreadContextUsageToolBucket"
        },
        "searchMedia": {
          "$ref": "#/definitions/ThreadContextUsageToolBucket"
        }
      },
      "required": [
        "applyPatch",
        "commands",
        "fileOperations",
        "interAgent",
        "otherTools",
        "searchMedia"
      ],
      "type": "object"
    },
    "ThreadContextUsageToolBucket": {
      "properties": {
        "input": {
          "format": "int64",
          "type": "integer"
        },
        "output": {
          "format": "int64",
          "type": "integer"
        }
      },
      "required": [
        "input",
        "output"
      ],
      "type": "object"
    },
    "ThreadSkillKind": {
      "enum": [
        "explicit",
        "implicit",
        "all"
      ],
      "type": "string"
    },
    "ThreadTokenUsage": {
      "properties": {
        "last": {
          "$ref": "#/definitions/TokenUsageBreakdown"
        },
        "modelContextWindow": {
          "format": "int64",
          "type": [
            "integer",
            "null"
          ]
        },
        "total": {
          "$ref": "#/definitions/TokenUsageBreakdown"
        }
      },
      "required": [
        "last",
        "total"
      ],
      "type": "object"
    },
    "TokenUsageBreakdown": {
      "properties": {
        "cachedInputTokens": {
          "format": "int64",
          "type": "integer"
        },
        "inputTokens": {
          "format": "int64",
          "type": "integer"
        },
        "outputTokens": {
          "format": "int64",
          "type": "integer"
        },
        "reasoningOutputTokens": {
          "format": "int64",
          "type": "integer"
        },
        "totalTokens": {
          "format": "int64",
          "type": "integer"
        }
      },
      "required": [
        "cachedInputTokens",
        "inputTokens",
        "outputTokens",
        "reasoningOutputTokens",
        "totalTokens"
      ],
      "type": "object"
    }
  },
  "properties": {
    "contextUsage": {
      "$ref": "#/definitions/ThreadContextUsage"
    },
    "threadId": {
      "type": "string"
    },
    "tokenUsage": {
      "$ref": "#/definitions/ThreadTokenUsage"
    },
    "turnId": {
      "type": "string"
    }
  },
  "required": [
    "contextUsage",
    "threadId",
    "tokenUsage",
    "turnId"
  ],
  "title": "ThreadContextUsageUpdatedNotification",
  "type": "object"
}