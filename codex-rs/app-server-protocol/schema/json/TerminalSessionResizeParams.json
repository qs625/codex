{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "CommandExecTerminalSize": {
      "description": "PTY size in character cells for `command/exec` PTY sessions.",
      "properties": {
        "cols": {
          "description": "Terminal width in character cells.",
          "format": "uint16",
          "minimum": 0.0,
          "type": "integer"
        },
        "rows": {
          "description": "Terminal height in character cells.",
          "format": "uint16",
          "minimum": 0.0,
          "type": "integer"
        }
      },
      "required": [
        "cols",
        "rows"
      ],
      "type": "object"
    },
    "TerminalSessionOrigin": {
      "enum": [
        "user",
        "model"
      ],
      "type": "string"
    }
  },
  "properties": {
    "commandItemId": {
      "type": [
        "string",
        "null"
      ]
    },
    "generation": {
      "type": "string"
    },
    "origin": {
      "$ref": "#/definitions/TerminalSessionOrigin"
    },
    "processId": {
      "type": "string"
    },
    "resumeToken": {
      "description": "Server-generated capability for a user terminal reattachment.",
      "type": [
        "string",
        "null"
      ]
    },
    "sessionId": {
      "type": "string"
    },
    "size": {
      "$ref": "#/definitions/CommandExecTerminalSize"
    },
    "threadId": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "generation",
    "origin",
    "processId",
    "sessionId",
    "size"
  ],
  "title": "TerminalSessionResizeParams",
  "type": "object"
}